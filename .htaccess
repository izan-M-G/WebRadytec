# Apache (por si se aloja en IONOS u otro hosting con Apache)
ErrorDocument 404 /404.html
RewriteEngine On
RewriteRule ^contacta-con-nosotros/?$ /contacto/ [R=301,L]
RewriteRule ^radytec-innovacion/?$ / [R=301,L]
RewriteRule ^(blog|feed)/?$ / [R=301,L]
RewriteRule ^(cilok|wp-admin)(/.*)?$ - [G,L]
RewriteRule ^(wp-login|xmlrpc)\.php$ - [G,L]
# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
